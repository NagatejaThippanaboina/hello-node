<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Login - Todo Manager</title>

    <link
        rel="stylesheet"
        href="/styles.css"
    >
</head>

<body class="auth-page">

    <div class="auth-container">

        <div class="auth-card">

            <h1>Todo Manager</h1>

            <h2>Sign In</h2>

            <!-- Flash Messages -->

            <% if (typeof messages !== "undefined" && messages.length > 0) { %>

                <% messages.forEach(function(message) { %>

                    <div class="flash-message">
                        <%= message %>
                    </div>

                <% }); %>

            <% } %>

            <!-- Login Form -->

            <form
                action="/login"
                method="POST"
            >

                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                >

                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        required
                    >

                </div>

                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        required
                    >

                </div>

                <button
                    type="submit"
                    class="auth-button"
                >
                    Sign In
                </button>

            </form>

            <p class="auth-link">

                Don't have an account?

                <a href="/signup">
                    Create an account
                </a>

            </p>

        </div>

    </div>

</body>

</html>