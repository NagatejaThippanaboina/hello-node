<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My Todo-list</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family:
                "Segoe UI",
                Tahoma,
                Geneva,
                Verdana,
                sans-serif;
            background: #ffffff;
            color: #222222;
            padding: 50px 30px;
        }

        .container {
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
        }

        h1 {
            font-size: 42px;
            font-weight: 700;
            margin-bottom: 35px;
        }

        .todo-form {
            display: grid;
            grid-template-columns: 1fr 280px auto;
            gap: 14px;
            margin-bottom: 38px;
        }

        .todo-form input {
            height: 58px;
            padding: 0 16px;
            border: 1px solid #cccccc;
            border-radius: 7px;
            font-size: 18px;
            outline: none;
        }

        .todo-form input:focus {
            border-color: #3749a6;
        }

        .todo-form button {
            height: 58px;
            padding: 0 30px;
            border: none;
            border-radius: 6px;
            background: #168548;
            color: white;
            font-size: 18px;
            cursor: pointer;
        }

        .todo-form button:hover {
            background: #126e3b;
        }

        .category {
            margin-bottom: 30px;
        }

        .category h2 {
            font-size: 28px;
            font-weight: 500;
            margin-bottom: 16px;
        }

        .todo-list {
            list-style: none;
        }

        .todo-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 52px;
            padding: 5px 10px;
        }

        .todo-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .todo-checkbox {
            width: 27px;
            height: 27px;
            cursor: pointer;
        }

        .todo-title {
            font-size: 21px;
        }

        .delete-button {
            border: none;
            background: transparent;
            font-size: 20px;
            cursor: pointer;
            opacity: 0.65;
        }

        .delete-button:hover {
            opacity: 1;
        }

        .empty {
            color: #888888;
            font-size: 17px;
            padding: 8px 0;
        }

        @media (max-width: 700px) {
            body {
                padding: 30px 18px;
            }

            h1 {
                font-size: 34px;
            }

            .todo-form {
                grid-template-columns: 1fr;
            }

            .todo-form button {
                width: 100%;
            }

            .todo-title {
                font-size: 18px;
            }
        }
    </style>
</head>

<body>
    <div class="container">

        <h1>My Todo-list</h1>

        <form action="/todos" method="POST" class="todo-form">
            <input
                type="text"
                name="title"
                placeholder="What's next?"
                required
            />

            <input
                type="date"
                name="dueDate"
                required
            />

            <button type="submit">Add</button>
        </form>

        <section class="category">
            <h2>Overdue</h2>

            <%- include("todos", { todos: overdue }) %>
        </section>

        <section class="category">
            <h2>Due Today</h2>

            <%- include("todos", { todos: dueToday }) %>
        </section>

        <section class="category">
            <h2>Due Later</h2>

            <%- include("todos", { todos: dueLater }) %>
        </section>

    </div>

    <script>
        async function deleteTodo(id) {
            try {
                const response = await fetch(`/todos/${id}`, {
                    method: "DELETE",
                });

                if (!response.ok) {
                    throw new Error("Failed to delete todo");
                }

                window.location.reload();
            } catch (error) {
                alert(error.message);
            }
        }
    </script>
</body>

</html>