<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My Todo-list</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family:
                "Segoe UI",
                Tahoma,
                Geneva,
                Verdana,
                sans-serif;
            background: #ffffff;
            color: #222222;
            padding: 50px 30px;
        }

        .container {
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 35px;
        }

        h1 {
            font-size: 42px;
            font-weight: 700;
        }

        .logout-button {
            padding: 10px 18px;
            border: 1px solid #cccccc;
            border-radius: 6px;
            background: #ffffff;
            color: #333333;
            font-size: 15px;
            cursor: pointer;
        }

        .logout-button:hover {
            background: #f5f5f5;
        }

        .todo-form {
            display: grid;
            grid-template-columns: 1fr 280px auto;
            gap: 14px;
            margin-bottom: 38px;
        }

        .todo-form input {
            height: 58px;
            padding: 0 16px;
            border: 1px solid #cccccc;
            border-radius: 7px;
            font-size: 18px;
            outline: none;
        }

        .todo-form input:focus {
            border-color: #3749a6;
        }

        .todo-form button {
            height: 58px;
            padding: 0 30px;
            border: none;
            border-radius: 6px;
            background: #168548;
            color: white;
            font-size: 18px;
            cursor: pointer;
        }

        .todo-form button:hover {
            background: #126e3b;
        }

        .category {
            margin-bottom: 30px;
        }

        .category h2 {
            font-size: 28px;
            font-weight: 500;
            margin-bottom: 16px;
        }

        .todo-list {
            list-style: none;
        }

        .todo-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 52px;
            padding: 5px 10px;
        }

        .todo-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .todo-checkbox {
            width: 27px;
            height: 27px;
            cursor: pointer;
        }

        .todo-title {
            font-size: 21px;
        }

        .delete-button {
            border: none;
            background: transparent;
            font-size: 20px;
            cursor: pointer;
            opacity: 0.65;
        }

        .delete-button:hover {
            opacity: 1;
        }

        .empty {
            color: #888888;
            font-size: 17px;
            padding: 8px 0;
        }

        .flash-message {
            margin-bottom: 20px;
            padding: 12px 14px;
            border-radius: 7px;
            background: #fee2e2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 14px;
        }

        @media (max-width: 700px) {
            body {
                padding: 30px 18px;
            }

            .header {
                align-items: flex-start;
                gap: 15px;
            }

            h1 {
                font-size: 34px;
            }

            .todo-form {
                grid-template-columns: 1fr;
            }

            .todo-form button {
                width: 100%;
            }

            .todo-title {
                font-size: 18px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Header -->

        <div class="header">

            <h1>My Todo-list</h1>

            <!-- Logout -->

            <form action="/logout" method="POST">

                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                />

                <button
                    type="submit"
                    class="logout-button"
                >
                    Logout
                </button>

            </form>

        </div>

        <!-- Flash Messages -->

        <% if (typeof messages !== "undefined" && messages.length > 0) { %>

            <% messages.forEach(function(message) { %>

                <div class="flash-message">
                    <%= message %>
                </div>

            <% }); %>

        <% } %>

        <!-- Add Todo -->

        <form
            action="/todos"
            method="POST"
            class="todo-form"
            id="todoForm"
        >

            <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
            />

            <input
                type="text"
                name="title"
                id="todoTitle"
                placeholder="What's next?"
                required
            />

            <input
                type="date"
                name="dueDate"
                id="todoDueDate"
                required
            />

            <button type="submit">
                Add
            </button>

        </form>

        <!-- Overdue -->

        <section class="category">

            <h2>Overdue</h2>

            <%- include("todos", { todos: overdue }) %>

        </section>

        <!-- Due Today -->

        <section class="category">

            <h2>Due Today</h2>

            <%- include("todos", { todos: dueToday }) %>

        </section>

        <!-- Due Later -->

        <section class="category">

            <h2>Due Later</h2>

            <%- include("todos", { todos: dueLater }) %>

        </section>

        <!-- Completed -->

        <section class="category">

            <h2>Completed Items</h2>

            <%- include("todos", {
                todos: completed,
                emptyMessage: "No completed todos in this category."
            }) %>

        </section>

    </div>

    <script>

        // =========================
        // CSRF TOKEN
        // =========================

        function getCsrfToken() {

            return document.querySelector(
                'input[name="_csrf"]'
            ).value;

        }

        // =========================
        // CLIENT VALIDATION
        // =========================

        document
            .getElementById("todoForm")
            .addEventListener(
                "submit",
                function (event) {

                    const title =
                        document
                            .getElementById(
                                "todoTitle"
                            )
                            .value
                            .trim();

                    const dueDate =
                        document
                            .getElementById(
                                "todoDueDate"
                            )
                            .value;

                    if (
                        !title ||
                        !dueDate
                    ) {

                        event.preventDefault();

                        alert(
                            "Please enter both a Todo title and due date."
                        );
                    }
                }
            );

        // =========================
        // COMPLETE / INCOMPLETE
        // =========================

        async function setCompletionStatus(
            id,
            completed
        ) {

            try {

                const response =
                    await fetch(
                        `/todos/${id}`,
                        {
                            method: "PUT",

                            headers: {
                                "Content-Type":
                                    "application/json",

                                "X-CSRF-Token":
                                    getCsrfToken()
                            },

                            body: JSON.stringify({
                                completed:
                                    completed
                            })
                        }
                    );

                if (!response.ok) {
                    throw new Error(
                        "Failed to update Todo"
                    );
                }

                window.location.reload();

            } catch (error) {

                alert(
                    error.message
                );

            }
        }

        // =========================
        // DELETE TODO
        // =========================

        async function deleteTodo(id) {

            try {

                const response =
                    await fetch(
                        `/todos/${id}`,
                        {
                            method: "DELETE",

                            headers: {
                                "X-CSRF-Token":
                                    getCsrfToken()
                            }
                        }
                    );

                if (!response.ok) {
                    throw new Error(
                        "Failed to delete Todo"
                    );
                }

                window.location.reload();

            } catch (error) {

                alert(
                    error.message
                );

            }
        }

    </script>

</body>

</html>